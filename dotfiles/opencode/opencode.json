{
  "$schema": "https://opencode.ai/config.json",
  "model": "google-vertex/gemini-4-argon#high",
  "providers": {
    "google": {
      "models": {
        "gemini-4-argon": {
          "settings": {
            "thinkingConfig": {
              "includeThoughts": true,
              "thinkingLevel": "high"
            }
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "effort": ["high"]
            }
          }
        }
      }
    },
    "google-vertex": {
      "models": {
        "gemini-4-argon": {
          "settings": {
            "thinkingConfig": {
              "includeThoughts": true,
              "thinkingLevel": "high"
            }
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "effort": ["high"]
            }
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--isolated"],
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--isolated",
          "--executable-path",
          "/home/szymon/.nix-profile/bin/chromium"
        ],
        "environment": {
          "PLAYWRIGHT_BROWSERS_PATH": ""
        },
        "disabled": false
      }
    }
  },
  "websearch": {
    "provider": "searxng"
  },
  "skills": ["~/.config/opencode/skills"]
}
