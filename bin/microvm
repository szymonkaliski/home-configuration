#!/usr/bin/env bash
set -euo pipefail

if [ "$(hostname -s)" != "minix" ]; then
  echo "error: microvm only runs on minix" >&2
  exit 1
fi

VM_BASE="$HOME/MicroVMs"
HOST_DIR="$VM_BASE/host"
SSH_OPTS=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR)
MAX_VMS=4

REPO_SETUP_SH="$PROJECTS_PATH/home-configuration/nix/hosts/minix/microvms/setup.sh"
REPO_AGENTS_MD="$PROJECTS_PATH/home-configuration/dotfiles/agents/AGENTS.md"

sync_host_config() {
  mkdir -p "$HOST_DIR"

  # single cross-harness instructions file; setup.sh merges in the VM context
  # and symlinks each harness's path at it
  command cp -L "$REPO_AGENTS_MD" "$HOST_DIR/AGENTS.md"

  # the VM's tailnet DNS name is <vm hostname> + this suffix
  tailscale status --json 2>/dev/null | jq -r '.MagicDNSSuffix // empty' > "$HOST_DIR/ts-magicdns-suffix" || true

  {
    echo "#!/usr/bin/env bash"
    echo "# DO NOT EDIT - copied from nix/hosts/minix/microvms/setup.sh"
    tail -n +2 "$REPO_SETUP_SH"
  } > "$HOST_DIR/setup.sh"

  chmod +x "$HOST_DIR/setup.sh"
}

# agent configs are written straight into the VM's home on the data share
# (uids pass through virtiofs unchanged), so the guest boot path only has to
# derive env exports and patch configs instead of copying hundreds of MB
stage_vm_home() {
  local VM="$1"
  local home="$VM_BASE/vm-${VM}/data/home/szymon"
  mkdir -p "$home/.config"
  rm -rf "$home/.claude" "$home/.claude.json" "$home/.config/gcloud" "$home/.config/opencode" "$home/.gemini"

  # ~/.claude/projects is host session state keyed by host paths; the VM
  # resolves /workspace to a different project slug and never reads it
  rsync -aL --exclude=/projects --exclude=/notify.log "$HOME/.claude/" "$home/.claude/" 2>/dev/null || true
  command cp -L "$HOME/.claude.json" "$home/.claude.json" 2>/dev/null || true
  command cp -rL "$HOME/.config/gcloud" "$home/.config/gcloud" 2>/dev/null || true
  # don't ship opencode's regenerable npm state or notification log
  rsync -aL --exclude=/node_modules --exclude=/package.json --exclude=/package-lock.json --exclude=/notify.log "$HOME/.config/opencode/" "$home/.config/opencode/" 2>/dev/null || true
  rsync -aL --exclude=/antigravity-cli/brain --exclude=/antigravity-cli/log --exclude=/antigravity-cli/cache "$HOME/.gemini/" "$home/.gemini/" 2>/dev/null || true

  # VMs auth via the long-lived token, not credentials file
  # remove it as a VM refreshing it would invalidate the host's session;
  # keep the plan tier around: token-only sessions have inference-only scope,
  # can't fetch the plan, and would gate fable behind usage credits
  # (anthropics/claude-code#79360)
  jq -r '.claudeAiOauth.subscriptionType // empty' "$home/.claude/.credentials.json" 2>/dev/null > "$home/.claude/subscription-type" || true
  rm -f "$home/.claude/.credentials.json"

  # extract the default claude code model when starting
  jq -r '.model // empty' "$home/.claude/settings.json" 2>/dev/null > "$home/.claude/anthropic-model" || true

  # setup.sh symlinks the merged AGENTS.md at each harness's path
  rm -f "$home/.claude/CLAUDE.md" "$home/.config/opencode/AGENTS.md" "$home/.gemini/config/AGENTS.md"

  # setup.sh touches this at the end of the boot-time setup; cmd_start waits for it
  rm -f "$VM_BASE/vm-${VM}/data/.setup-done"
}

find_free_vm() {
  for i in $(seq 1 "$MAX_VMS"); do
    local state
    state=$(systemctl is-active "microvm@vm-${i}" 2>/dev/null || true)
    if [ "$state" = "inactive" ] || [ "$state" = "failed" ]; then
      echo "$i"
      return
    fi
  done
  echo "error: all VMs in use" >&2
  exit 1
}

cmd_start() {
  local VM="" PROJECT="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) PROJECT="$2"; shift 2 ;;
      *) VM="$1"; shift ;;
    esac
  done
  [ -z "$VM" ] && VM=$(find_free_vm)
  case "$(systemctl is-active "microvm@vm-${VM}" 2>/dev/null || true)" in
    active|activating|deactivating)
      echo "error: vm-${VM} is running or shutting down, use ssh or restart" >&2
      exit 1
      ;;
  esac
  PROJECT=$(realpath "$PROJECT")
  # drop empty microvm:kvm-owned data/ recreated by tmpfiles after a clean
  rmdir "$VM_BASE/vm-${VM}/data" 2>/dev/null || true
  mkdir -p "$VM_BASE/vm-${VM}/data/home"
  rm -rf "$VM_BASE/vm-${VM}/workspace"
  ln -s "$PROJECT" "$VM_BASE/vm-${VM}/workspace"
  sync_host_config
  stage_vm_home "$VM"
  t0=$SECONDS
  printf "vm-%s (10.100.0.%s) %s\n" "$VM" "$VM" "$PROJECT"
  printf "starting..."
  systemctl reset-failed "microvm@vm-${VM}" 2>/dev/null || true
  systemctl start --no-block "microvm@vm-${VM}"
  printf " booting..."
  # fast path: setup.sh touches .setup-done on the data share; every ~5s also
  # check unit states over ssh to catch failures the file can't signal
  local ticks=0
  while true; do
    if [ -f "$VM_BASE/vm-${VM}/data/.setup-done" ]; then
      break
    fi
    ticks=$(( ticks + 1 ))
    if [ $(( ticks % 50 )) -eq 0 ]; then
      local setup_state
      setup_state=$(ssh -o ConnectTimeout=1 "${SSH_OPTS[@]}" "szymon@10.100.0.${VM}" \
        'systemctl is-active setup-user.service' 2>/dev/null || true)
      if [ "$setup_state" = "failed" ]; then
        echo " failed"
        echo "error: setup-user.service failed in vm-${VM}" >&2
        exit 1
      fi
      local svc_state
      svc_state=$(systemctl is-active "microvm@vm-${VM}" 2>/dev/null || true)
      if [ "$svc_state" = "failed" ]; then
        echo " failed"
        echo "error: microvm@vm-${VM} failed to start" >&2
        exit 1
      fi
    fi
    sleep 0.1
  done
  elapsed=$(( SECONDS - t0 ))
  # sshd may come up a moment after setup-user finishes, retry the connection
  failed=$(ssh -o ConnectionAttempts=5 "${SSH_OPTS[@]}" "szymon@10.100.0.${VM}" "systemctl --failed --no-legend --no-pager" 2>/dev/null || true)
  if [ -n "$failed" ]; then
    echo " ready (${elapsed}s, with failures)"
    echo "$failed"
  else
    echo " ready (${elapsed}s)"
  fi
  notify-pushover "vm-${VM} ready (${elapsed}s) ${PROJECT##*/}" 2>/dev/null || true
  exec ssh -t -o ConnectionAttempts=5 "${SSH_OPTS[@]}" "szymon@10.100.0.${VM}"
}

stop_vm() {
  local VM="$1"
  ssh -o ConnectTimeout=3 "${SSH_OPTS[@]}" "szymon@10.100.0.${VM}" "sudo tailscale logout" 2>/dev/null || true
  systemctl stop "microvm@vm-${VM}"
  # PartOf already queues this stop; block on it here so the teardown cost
  # is paid now and not by the next start
  systemctl stop "microvm-virtiofsd@vm-${VM}" 2>/dev/null || true
}

cmd_stop() {
  [ $# -lt 1 ] && echo "usage: microvm stop <N>" && exit 1
  echo "stopping vm-${1}..."
  stop_vm "$1"
  echo "vm-${1} stopped"
}

cmd_ssh() {
  [ $# -lt 1 ] && echo "usage: microvm ssh <N>" && exit 1
  if ! systemctl is-active "microvm@vm-${1}" &>/dev/null; then
    echo "error: vm-${1} is not running" >&2; exit 1
  fi
  ssh -t "${SSH_OPTS[@]}" "szymon@10.100.0.${1}"
}

cmd_list() {
  for i in $(seq 1 "$MAX_VMS"); do
    state=$(systemctl is-active "microvm@vm-${i}" 2>/dev/null || true)
    case "$state" in
      active|activating) status="running" ;;
      deactivating) status="stopping" ;;
      *) status="stopped" ;;
    esac
    ws=$(readlink "$VM_BASE/vm-${i}/workspace" 2>/dev/null || echo "(none)")
    printf "vm-%-2d  %-8s  %s\n" "$i" "$status" "$ws"
  done
}

cmd_stop_all() {
  local pids=()
  for i in $(seq 1 "$MAX_VMS"); do
    if systemctl is-active "microvm@vm-${i}" &>/dev/null; then
      echo "stopping vm-${i}..."
      stop_vm "$i" &
      pids+=($!)
    fi
  done
  wait "${pids[@]}" 2>/dev/null
  echo "all stopped"
}

kill_vm() {
  local VM="$1"
  systemctl kill "microvm@vm-${VM}"
  systemctl stop "microvm@vm-${VM}" 2>/dev/null || true
  systemctl stop "microvm-virtiofsd@vm-${VM}" 2>/dev/null || true
}

cmd_kill() {
  [ $# -lt 1 ] && echo "usage: microvm kill <N>" && exit 1
  kill_vm "$1"
  echo "killed vm-${1}"
}

cmd_kill_all() {
  local pids=()
  for i in $(seq 1 "$MAX_VMS"); do
    if systemctl is-active "microvm@vm-${i}" &>/dev/null; then
      echo "killing vm-${i}..."
      kill_vm "$i" &
      pids+=($!)
    fi
  done
  wait "${pids[@]}" 2>/dev/null
  echo "all killed"
}

clean_vm() {
  local VM="$1"
  sudo /run/current-system/sw/bin/microvm-clean overlay "${VM}"
  sudo /run/current-system/sw/bin/microvm-clean data "${VM}"
  rm -rf "$VM_BASE/vm-${VM}/workspace"
}

cmd_clean() {
  [ $# -lt 1 ] && echo "usage: microvm clean <N>" && exit 1
  if systemctl is-active "microvm@vm-${1}" &>/dev/null; then
    echo "error: vm-${1} is running, stop it first" >&2; exit 1
  fi
  clean_vm "$1"
  echo "vm-${1} cleaned"
}

cmd_clean_all() {
  local pids=()
  for i in $(seq 1 "$MAX_VMS"); do
    if systemctl is-active "microvm@vm-${i}" &>/dev/null; then
      echo "skipping vm-${i} (running)"
      continue
    fi
    clean_vm "$i" &
    pids+=($!)
  done
  wait "${pids[@]}" 2>/dev/null
  echo "all cleaned"
}

cmd_restart() {
  [ $# -lt 1 ] && echo "usage: microvm restart <N>" && exit 1
  local VM="$1"
  if ! systemctl is-active "microvm@vm-${VM}" &>/dev/null; then
    echo "error: vm-${VM} is not running" >&2; exit 1
  fi
  local ws
  ws=$(readlink "$VM_BASE/vm-${VM}/workspace" 2>/dev/null || true)
  [ -z "$ws" ] && echo "error: no workspace for vm-${VM}" >&2 && exit 1
  echo "stopping vm-${VM}..."
  stop_vm "$VM"
  echo "restarting..."
  cmd_start "$VM" --dir "$ws"
}

cmd_usage() {
  cat <<EOF
usage: microvm <command> [args]

  list, ls                  show all VMs

  start [N] [--dir PATH]    start VM (default cwd; auto-pick if N omitted)
  ssh N                     ssh into running VM
  stop N                    stop VM
  restart N                 restart VM (preserves workspace)
  kill N                    kill VM
  clean N                   clean all ephemeral data for VM

  stop-all                  stop all VMs
  kill-all                  kill all VMs
  clean-all                 clean all stopped VMs
EOF
}

CMD="${1:-help}"
shift || true

case "$CMD" in
  start)     cmd_start "$@" ;;
  stop)      cmd_stop "$@" ;;
  ssh)       cmd_ssh "$@" ;;
  list|ls)   cmd_list ;;
  stop-all)  cmd_stop_all ;;
  kill)      cmd_kill "$@" ;;
  kill-all)  cmd_kill_all ;;
  clean)     cmd_clean "$@" ;;
  clean-all) cmd_clean_all ;;
  restart)   cmd_restart "$@" ;;
  *)         cmd_usage ;;
esac
