{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--isolated"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--executable-path",
        "/home/szymon/.nix-profile/bin/chromium"
      ],
      "environment": {
        "PLAYWRIGHT_BROWSERS_PATH": ""
      },
      "enabled": true
    }
  },
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  }
}
