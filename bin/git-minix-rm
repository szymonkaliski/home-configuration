#!/usr/bin/env bash
set -euo pipefail

name="${1:?Usage: git minix-rm <name>}"
name="${name%.git}"

run_on_minix() {
  if [ "$(hostname -s)" = "minix" ]; then
    eval "$1"
  else
    # $1 is the already-built command string; expand it locally, not on the remote
    # shellcheck disable=SC2029
    ssh minix "$1"
  fi
}

printf 'Delete ~/Git/%s.git on minix? [y/N] ' "$name"
read -r confirm
if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
  run_on_minix "rm -rf ~/Git/${name}.git"
  echo "Deleted ${name}"
else
  echo "Aborted"
fi
