#!/usr/bin/env bash

setup_session() {
  local basedir=$1
  local title=$2
}

get_basedir() {
  if [[ ${PWD##*/} == "Code" ]]; then
    dirname "$PWD"
  else
    echo "$PWD"
  fi
}

get_title() {
  if [ "$#" -ne 0 ]; then
    echo "$1"
    return
  fi

  if [[ $PWD == "$HOME" ]]; then
    echo "home"
    return
  fi

  local dir=""

  if [[ ${PWD##*/} == "Code" ]]; then
    basedir=$(get_basedir)
    dir=$(basename "$basedir")
  else
    dir=${PWD##*/}
  fi

  echo "$dir" | tr "[:upper:]" "[:lower:]" | sed "s/^[0-9][0-9][0-9][0-9]\ \-\ //g" | sed "s/[\ |\.]/\-/g"
}

get_session() {
  local title=$1

  if tmux has-session -t "=$title" > /dev/null 2>&1; then
    echo "$title"
  fi
}

run() {
  local title
  local basedir
  local session

  title=$(get_title "$@")
  basedir=$(get_basedir)
  session=$(get_session "$title")

  if [[ $session != "" ]] && [ -z "$TMUX" ]; then
    tmux attach -t "$session"
    return
  fi

  if [[ $session != "" ]] && [ -n "$TMUX" ]; then
    tmux switch-client -t "$session"
    return
  fi

  if [[ $session == "" ]] && [ -z "$TMUX" ]; then
    tmux new-session -d -s "$title"
    setup_session "$basedir" "$title"
    tmux attach -t "$title"
    return
  fi

  if [[ $session == "" ]] && [ -n "$TMUX" ]; then
    # keep $TMUX: it names both the socket and the calling client, so clearing it
    # sends switch-client to the default socket with no client to move (which fails
    # outright from a popup, where the caller's tty is not a client tty)
    tmux new-session -d -s "$title"
    setup_session "$basedir" "$title"
    tmux switch-client -t "$title"
    return
  fi
}

run "$@"
