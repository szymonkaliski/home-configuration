#!/usr/bin/env bash

function gitUpdate {
  if [ -d "$*" ]; then
    pushd "$*" > /dev/null || return

    if [ -e .git ]; then
      echo -e "$(tput setaf 2)Checking $(basename "$*")...$(tput sgr0)"
      git pull
      echo
    fi

    popd > /dev/null || return
  fi
}

HOSTNAME=$(hostname -s)

# pull the home-configuration repo first (resolve symlink to find repo root)
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(dirname "$(dirname "$REAL_SCRIPT")")"
gitUpdate "$REPO_DIR"

# skill dirs under agents/skills are symlinks into these clones, so a missing
# clone is a missing skill - setup.sh does the cloning
if [ -d "$REPO_DIR/dotfiles/agents/skills-vendor" ]; then
  for i in "$REPO_DIR"/dotfiles/agents/skills-vendor/*; do
    gitUpdate "$i"
  done
fi

if [[ $HOSTNAME == "orchid" ]]; then
  echo -e "$(tput setaf 2)Checking Nix...$(tput sgr0)"

  pushd ~/.config/home-manager > /dev/null || exit 1

  sudo determinate-nixd upgrade
  nh home switch . -u -c szymon@orchid
  echo

  popd > /dev/null || exit 1
elif [[ $HOSTNAME == "minix" || $HOSTNAME == "berry" ]]; then
  echo -e "$(tput setaf 2)Checking Nix...$(tput sgr0)"

  pushd ~/.config/home-manager > /dev/null || exit 1

  # -u on the first call only, so home-manager builds from the same revision
  nh os switch . -u -H "$HOSTNAME"
  nh home switch . -c "szymon@$HOSTNAME"
  echo

  popd > /dev/null || exit 1
fi

if [ -d ~/.zsh/plugins ]; then
  for i in ~/.zsh/plugins/*; do
    gitUpdate "$i"
  done
fi

if [ -d ~/.tmux/plugins ]; then
  for i in ~/.tmux/plugins/*; do
    gitUpdate "$i"
  done
fi

if command -v npm > /dev/null 2>&1; then
  echo -e "$(tput setaf 2)Checking NPM...$(tput sgr0)"
  npm-sync
  echo
fi

if hash vale 2> /dev/null; then
  pushd ~/ > /dev/null || exit 1
  echo -e "$(tput setaf 2)Checking Vale...$(tput sgr0)"
  vale sync
  popd > /dev/null || exit 1
fi
