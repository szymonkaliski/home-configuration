{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--isolated"],
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--isolated",
          "--executable-path",
          "/home/szymon/.nix-profile/bin/chromium"
        ],
        "environment": {
          "PLAYWRIGHT_BROWSERS_PATH": ""
        },
        "disabled": false
      }
    }
  },
  "skills": ["~/.config/opencode/skills"]
}
