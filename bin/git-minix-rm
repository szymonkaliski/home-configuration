#!/usr/bin/env bash
set -euo pipefail

name="${1:?Usage: git minix-rm <name>}"
name="${name%.git}"

printf 'Delete ~/Git/%s.git on minix? [y/N] ' "$name"
read -r confirm
if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
  # ~ expands on minix, not here
  # shellcheck disable=SC2029
  ssh minix "rm -rf ~/Git/${name}.git"
  echo "Deleted ${name}"
else
  echo "Aborted"
fi
