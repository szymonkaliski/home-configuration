#!/usr/bin/env bash
set -euo pipefail

run_on_minix() {
  if [ "$(hostname -s)" = "minix" ]; then
    eval "$1"
  else
    # $1 is the already-built command string; expand it locally, not on the remote
    # shellcheck disable=SC2029
    ssh minix "$1"
  fi
}

run_on_minix "ls ~/Git" | sed 's/\.git$//'
