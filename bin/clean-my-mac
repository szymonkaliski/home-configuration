#!/usr/bin/env bash
# simple interactive mac cleanup script

read -rp "$(tput setaf 3)Clean packager caches?$(tput sgr0) (y/N) " RESP
if [ "$RESP" == "y" ] || [ "$RESP" == "Y" ]; then
  if hash yarn > /dev/null; then
    yarn cache clean
  fi

  if hash npm > /dev/null; then
    npm cache clean --force
  fi

  if hash pod > /dev/null; then
    pod cache clean --all
  fi

  if hash pnpm > /dev/null; then
    pnpm store prune
  fi
fi

read -rp "$(tput setaf 3)Clean docker caches?$(tput sgr0) (y/N) " RESP
if [ "$RESP" == "y" ] || [ "$RESP" == "Y" ]; then
  docker system prune
fi

read -rp "$(tput setaf 3)Clean nix garbage?$(tput sgr0) (y/N) " RESP
if [ "$RESP" == "y" ] || [ "$RESP" == "Y" ]; then
  nix-collect-garbage
fi

read -rp "$(tput setaf 3)Clean xcode caches?$(tput sgr0) (y/N) " RESP
if [ "$RESP" == "y" ] || [ "$RESP" == "Y" ]; then
  xcrun simctl delete unavailable
fi

read -rp "$(tput setaf 3)Run periodic scripts?$(tput sgr0) (y/N) " RESP
if [ "$RESP" == "y" ] || [ "$RESP" == "Y" ]; then
  sudo periodic daily weekly monthly
fi

read -rp "$(tput setaf 3)Rebuild Spotlight?$(tput sgr0) (y/N) " RESP
if [ "$RESP" == "y" ] || [ "$RESP" == "Y" ]; then
  sudo mdutil -E /
fi

echo -e "\n$(tput setaf 1)Clean done, restart your computer!$(tput sgr0)"
